{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "expand": "auto",
    "includes": ["**", "!node_modules", "!!package.json", "!!**/app.json"]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "warn"
      },
      "correctness": {
        "useImportExtensions": {
          "options": {
            "forceJsExtensions": true
          },
          "level": "error"
        }
      }
    },
    "includes": ["**", "!node_modules", "!!package.json", "!!**/app.json"]
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "lineWidth": 200,
      "trailingCommas": "none",
      "semicolons": "always"
    }
  },
  "overrides": [
    {
      "includes": ["**", "!node_modules", "!!package.json", "!!**/app.json"],
      "javascript": {
        "globals": []
      },
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedVariables": "error"
          },
          "complexity": {
            "useLiteralKeys": "off"
          },
          "style": {
            "noUnusedTemplateLiteral": "error",
            "noUselessElse": "error",
            "useCollapsedIf": "error",
            "useConst": "error"
          },
          "a11y": {
            "noSvgWithoutTitle": "off",
            "useHtmlLang": "off",
            "noLabelWithoutControl": {
              "level": "error",
              "options": {
                "labelAttributes": ["data-i18n"]
              }
            }
          }
        }
      }
    }
  ],
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
