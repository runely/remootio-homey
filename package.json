{
  "name": "no.runely.remootio",
  "version": "1.3.2",
  "main": "app.js",
  "repository": {
    "url": "https://github.com/runely/remootio-homey"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "GPL-3.0-or-later",
  "scripts": {
    "test": "biome check --max-diagnostics 10000",
    "test:fix": "biome check --write --max-diagnostics 10000",
    "refresh": "rm -rf node_modules && rm package-lock.json && npm i",
    "homey-build": "homey app build",
    "homey-run": "homey app run --remote",
    "homey-install": "npm run test && homey app install",
    "homey-publish": "npm run test && homey app publish"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/homey": "npm:homey-apps-sdk-v3-types@1.8.3",
    "@types/node": "^26.6.5"
  },
  "dependencies": {
    "remootio-api-client": "^2.0.5"
  }
}
